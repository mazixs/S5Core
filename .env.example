# Server configuration. Generate credentials with ./scripts/init-env.sh HOST:28479.
# All optional settings: docs/guides/configuration.md.
PROXY_USER=s5user
PROXY_PASSWORD=
REQUIRE_AUTH=true
# s5core refuses destinations on its own machine and network (loopback, private,
# link-local, carrier-grade NAT). Set true only if clients must reach them.
# ALLOW_PRIVATE_DEST=false
PROXY_PORT=28173
METRICS_PORT=8789

OBFS_ENABLED=true
OBFS_PORT=28479
# For native game UDP, set UDP_PORT=28479 and publish that port over UDP.
# UDP_PORT=28479
# Temporary per-association UDP reports (Debug, without packet contents).
# UDP_DIAGNOSTICS_INTERVAL=5s
# LOG_LEVEL=debug
# Exactly 32 characters: openssl rand -base64 24
OBFS_PSK=

# Optional node binding. Empty/omitted works; must match the client if set.
# OBFS_NODE_ID=edge-1

# TCP Fast Open on the obfs port, for a field measurement only (limitations:
# docs/field/stealth.md): needs net.ipv4.tcp_fastopen=3 (docs/guides/docker.md)
# and OBFS_TFO=true on the client.
# OBFS_TFO=false

# Session journal: one line per connection with account and destination network.
# Off by default; read docs/design/observability-policy.md before enabling.
# SESSION_LOG=abnormal
# SESSION_LOG_FILE=/var/log/s5core/sessions.jsonl
