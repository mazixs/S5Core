# Client only. Run on the client machine; the server uses .env.
# Generate a matching pair with ./scripts/init-env.sh HOST:28479.
SERVER_ADDR=YOUR_SERVER_IP:28479
PROXY_USER=s5user
PROXY_PASS=
OBFS_PSK=
OBFS_FORMAT=v1
CLIENT_LISTEN_ADDR=127.0.0.1:1080

# Must match the server if set.
# OBFS_NODE_ID=edge-1
