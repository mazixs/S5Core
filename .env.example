# Server and client options. Uncomment to override defaults.
# Details: README.md, docs/field/migration.md, docs/veil-spec.md.

# Authentication
PROXY_USER=user
PROXY_PASSWORD=password
# Client name: PROXY_PASS; also accepted by the server as an alias.

# Multi-account mode; tunnel_key setup: docs/benchmarks/roster.md.
# USERS_FILE=/etc/s5core/users.json
# 0 = 256 MiB budget; each concurrent Argon2id check needs 64 MiB.
# KDF_MEMORY_BUDGET_MB=0
# Traffic persistence interval; active-session quotas are checked separately.
# TRAFFIC_FLUSH_INTERVAL=60s

# Server
# PROXY_PORT=1080
# PROXY_LISTEN_IP=0.0.0.0
# REQUIRE_AUTH=true

# Access control
# Destination regex, anchored unless explicitly anchored; checked before DNS.
# ALLOWED_DEST_FQDN=
# Comma-separated IPv4/IPv6 addresses, no CIDR. Empty allows any client IP.
# ALLOWED_IPS=

# Timeouts and limits
# Relay idle timeouts, refreshed by traffic; not applied to UDP tunnels.
# READ_TIMEOUT=30s
# WRITE_TIMEOUT=30s
# Absolute setup budget; also bounds silent obfs probes.
# HANDSHAKE_TIMEOUT=15s
# DNS + connect budget, within HANDSHAKE_TIMEOUT.
# DIAL_TIMEOUT=10s
# Limits incomplete obfs frames, not idle connections.
# FRAME_TIMEOUT=10s
# Drain time after quota exhaustion; 0 closes immediately.
# QUOTA_GRACE=5s
# MAX_CONNECTIONS=10000

# Fail2Ban
# Source failures before a ban; IPv6 sources are grouped by /64.
# FAIL2BAN_RETRIES=5
# Ban duration and per-account counter window.
# FAIL2BAN_TIME=5m

# Observability
# debug, info, warn, error. Logging policy: docs/design/observability-policy.md.
# LOG_LEVEL=info
# Overrides LOG_LEVEL; reread on SIGHUP. SIGUSR1 toggles debug.
# LOG_LEVEL_FILE=
# METRICS_PORT=8080
# Keep metrics private; 0.0.0.0 is for a trusted container network or VPN.
# METRICS_BIND_ADDR=127.0.0.1

# Obfuscation
# OBFS_ENABLED=false
# Example port; built-in default is 1443. Use WebSocket/TLS for port 443.
# OBFS_PORT=27015
# OBFS_PSK=your-32-byte-pre-shared-key-here
# Padding and MTU apply to outgoing frames; peers may use different values.
# OBFS_MAX_PADDING=256
# OBFS_MTU=1400
# Server keepalive is disabled by default; client defaults are below.
# KEEPALIVE_MIN=0s
# KEEPALIVE_MAX=0s
# Remembered session salts across server listeners; 0 disables replay checks.
# OBFS_REPLAY_WINDOW=10000
# Client: printable (default) or raw. See docs/field/stealth.md.
# OBFS_PROLOGUE=
# Client: send the opening separately; default false.
# OBFS_SPLIT_OPENING=
# Client: aes, chacha, or empty for hardware-based selection.
# OBFS_CIPHER=
# Must match on both peers, including the empty value; never sent on the wire.
OBFS_NODE_ID=
# Server: comma-separated previous node IDs accepted during migration.
# OBFS_ACCEPT_NODE_IDS=
# Client: account ID and its tunnel_key from the server's users.json.
# OBFS_MEMBER_ID=
# OBFS_MEMBER_KEY=
# Server: enable only after all clients have individual tunnel keys.
# OBFS_REQUIRE_MEMBER_KEY=false
# Peer clocks must be within two hours; otherwise authentication fails.

# WebSocket/TLS server
# WS_ENABLED=false
# WS_ADDR=0.0.0.0:443
# WS_CERT_FILE=/path/to/cert.pem
# WS_KEY_FILE=/path/to/key.pem
# Exact literal path, not / or /favicon.ico; no trailing /, query, escapes or wildcards.
# WS_PATH=/ws
# WS_SUBPROTOCOL=
# Non-tunnel requests go here; empty uses the built-in decoy page.
# WS_DECOY_UPSTREAM=
# ws, obfs, or fields: transport=ws min_frame=512 max_frame=2048 jitter_ms=5
# Advice applies from the next connection; the transport must be enabled here.
# TRANSPORT_ADVICE=
# Overrides TRANSPORT_ADVICE; reread on SIGHUP. See docs/field/migration.md.
# TRANSPORT_ADVICE_FILE=

# WebSocket/TLS client
# WS_URL=wss://your-domain.com/ws
# WS_HOST=your-domain.com
# WS_ORIGIN=https://your-domain.com
# WS_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
# SNI and certificate name; empty falls back to WS_HOST, then the WS_URL host.
# SERVER_NAME=
# Trusted PEM certificate/CA file; replaces system roots.
# WS_CA_FILE=
# Comma-separated SHA-256 SPKI hashes, hex; checked in addition to the chain.
# WS_PIN_SHA256=
# Client only.
# TLS_FINGERPRINT=chrome

# Outgoing WS frame shaping; peers may differ. WS_MAX_FRAME=0 disables it.
# WS_MIN_FRAME=256
# WS_MAX_FRAME=4096
# WS_MAX_JITTER_MS=0

# S5Client
# CLIENT_LISTEN_ADDR=127.0.0.1:1080
# Includes local handshakes; excess connections close.
# CLIENT_MAX_CONNECTIONS=1024
# Opt-in request to ipapi.co; exposes the client/proxy pairing to a third party.
# TIMEZONE_CHECK=false
# Connection budget for reaching the server.
# DIAL_TIMEOUT=10s
# Local handshake and tunnel setup deadlines; cleared after setup.
# HANDSHAKE_TIMEOUT=15s
# SHUTDOWN_TIMEOUT=10s
# Idle keepalive range; keep below the path's shortest idle timeout. 0 disables.
# KEEPALIVE_MIN=10s
# KEEPALIVE_MAX=20s
# SERVER_ADDR=your-server-ip:27015
# ROUTE_DOMAINS=example.com,*.google.com
# auto follows server advice and fallback; explicit obfs/ws pins the transport.
# Configure both SERVER_ADDR and WS_URL for transport switching.
# TRANSPORT=auto
# Failed transport cooldown; 0 disables switching.
# TRANSPORT_COOLDOWN=5m
# auto tries v1 with temporary legacy fallback; pin v1 after server migration.
# OBFS_FORMAT=auto
# OBFS_FORMAT_REPROBE=10m

# Docker Compose only; container listener addresses are managed by Compose.
# docker-compose.wss.yml: fullchain.pem and privkey.pem, readable by UID 65532.
# S5CORE_CERTS_DIR=./certs
# WS_PORT=443
# docker-compose.users.yml: users.json and directory writable by UID 65532.
# S5CORE_DATA_DIR=./data
